<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <!-- Every test finishes in milliseconds; threading TestContext cancellation through them buys nothing. -->
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
        <!-- Microsoft.AspNetCore.OpenApi's XML-comment generator reaches this project through the Zooper.Ant.AspNetCore
             project reference, but the package's build targets that enable its interceptors do not. NuGet consumers get
             neither, so only the in-repository projects need this. -->
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="4.0.2" />
        <PackageReference Include="Shouldly" Version="4.3.0" />
        <PackageReference Include="NSubstitute" Version="5.3.0" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Zooper.Ant\Zooper.Ant.csproj" />
        <ProjectReference Include="..\Zooper.Ant.AspNetCore\Zooper.Ant.AspNetCore.csproj" />
    </ItemGroup>

</Project>
